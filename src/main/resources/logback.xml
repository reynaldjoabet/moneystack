<configuration>
    <!--
      LOG_FORMAT picks the console format: `text` (default) for people, `json` (one object per line) for log
      collectors; each lives in logback-<format>.xml. LOG_LEVEL sets the root level (default INFO).
    -->
    <include resource="logback-${LOG_FORMAT:-text}.xml"/>

    <!-- Flyway prints a line per migration at INFO; keep only its warnings. -->
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="skunk" level="INFO"/>
    <logger name="org.http4s" level="INFO"/>
    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="console"/>
    </root>
</configuration>
